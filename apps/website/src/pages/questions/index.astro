---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allQuestions = await getCollection('questions');
const allVariants = await getCollection('variants');
const allTopics = await getCollection('topics');
const allCategories = await getCollection('categories');
const allTechnologies = await getCollection('technologies');

const topicMap = new Map(allTopics.map(t => [t.data.id, t.data]));
const categoryMap = new Map(allCategories.map(c => [c.data.id, c.data]));
const techMap = new Map(allTechnologies.map(t => [t.data.id, t.data]));

// Build question -> techs map
const questionTechMap = new Map<string, string[]>();
allVariants.forEach(v => {
	const techs = questionTechMap.get(v.data.question) || [];
	const tech = techMap.get(v.data.technology);
	if (tech) techs.push(tech.name);
	questionTechMap.set(v.data.question, techs);
});

// Group questions by topic, then by category
const diffOrder: Record<string, number> = { Beginner: 0, Easy: 1, Medium: 2, Hard: 3, Expert: 4 };

type TopicGroup = {
	topic: typeof allTopics[0]['data'];
	questions: typeof allQuestions;
};

type CategoryGroup = {
	category: typeof allCategories[0]['data'];
	topicGroups: TopicGroup[];
};

const categoryGroups: CategoryGroup[] = [];

// Build groups
const topicsByCategory = new Map<string, typeof allTopics>();
allTopics.forEach(t => {
	const list = topicsByCategory.get(t.data.category) || [];
	list.push(t);
	topicsByCategory.set(t.data.category, list);
});

allCategories.forEach(cat => {
	const catTopics = topicsByCategory.get(cat.data.id) || [];
	const topicGroups: TopicGroup[] = catTopics.map(topic => ({
		topic: topic.data,
		questions: allQuestions
			.filter(q => q.data.topic === topic.data.id)
			.sort((a, b) => (diffOrder[a.data.difficulty] || 0) - (diffOrder[b.data.difficulty] || 0)),
	})).filter(tg => tg.questions.length > 0);

	if (topicGroups.length > 0) {
		categoryGroups.push({ category: cat.data, topicGroups });
	}
});

function getDifficultyClass(diff: string): string {
	return `badge--${diff.toLowerCase()}`;
}
---

<Layout title="All Questions" description="Browse all interview questions grouped by category and topic.">
	<div class="page-header">
		<h1 class="page-header__title">All Questions</h1>
		<p class="page-header__subtitle">{allQuestions.length} questions across {allTopics.length} topics</p>
	</div>

	{categoryGroups.map(({ category, topicGroups }) => (
		<div class="category-section">
			<h2 class="category-section__title">
				<span class={`badge ${category.id === 'category.frontend' ? 'badge--frontend' : 'badge--backend'}`} style="margin-right: 0.5rem; vertical-align: middle;">
					{category.title}
				</span>
			</h2>

			{topicGroups.map(({ topic, questions }) => (
				<div style="margin-bottom: 1.5rem;">
					<h3 style="font-size: 1rem; font-weight: 600; color: var(--color-text-primary); margin: 0 0 0.75rem;">
						<a href={`/topics/${topic.slug}`} style="color: inherit; border-bottom: 1px dashed var(--color-border-default);">{topic.title}</a>
						<span style="color: var(--color-text-tertiary); font-weight: 400; font-size: 0.8125rem; margin-left: 0.5rem;">{questions.length} questions</span>
					</h3>
					<div class="question-grid stagger-children">
						{questions.map((question) => {
							const techs = questionTechMap.get(question.data.id) || [];
							return (
								<a href={`/questions/${question.id}`} class="card card--interactive">
									<div class="card__header">
										<span class={`badge ${getDifficultyClass(question.data.difficulty)}`}>{question.data.difficulty}</span>
										<span class="question-card__time">
											<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
											{question.data.estimated_time}m
										</span>
									</div>
									<h2 class="card__title">{question.data.title}</h2>
									<div class="card__meta">
										<div class="question-card__techs">
											{techs.map(tech => (
												<span class="badge badge--tech">{tech}</span>
											))}
										</div>
									</div>
								</a>
							);
						})}
					</div>
				</div>
			))}
		</div>
	))}
</Layout>
