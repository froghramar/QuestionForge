---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const questions = await getCollection('questions');
	return questions.map((question) => ({
		params: { id: question.id },
		props: { question },
	}));
}

const { question } = Astro.props;
const { Content } = await render(question);

// Fetch all collections needed for lookup
const allTopics = await getCollection('topics');
const allConcepts = await getCollection('concepts');
const allVariants = await getCollection('variants');
const allTechnologies = await getCollection('technologies');

// Lookup by custom stable ID
const topic = allTopics.find(t => t.data.id === question.data.topic);
const questionVariants = allVariants.filter(v => v.data.question === question.data.id);

const techMap = new Map(allTechnologies.map(t => [t.data.id, t.data]));

const relatedConcepts = question.data.concepts 
	? question.data.concepts.map(id => allConcepts.find(c => c.data.id === id)).filter(Boolean)
	: [];

// Prepare variants with their rendered content
const renderedVariants = await Promise.all(questionVariants.map(async (variant) => {
	const { Content: VariantContent } = await render(variant);
	return {
		...variant,
		VariantContent,
		tech: techMap.get(variant.data.technology)
	};
}));
---

<Layout title={question.data.title}>
	<article class="max-w-4xl mx-auto py-8">
		<nav class="flex mb-8 text-sm text-gray-500" aria-label="Breadcrumb">
			<ol class="flex items-center space-x-2">
				<li><a href="/" class="hover:text-indigo-600">Home</a></li>
				<li><span class="mx-2">/</span></li>
				<li><a href="/questions" class="hover:text-indigo-600">Questions</a></li>
				<li><span class="mx-2">/</span></li>
				<li class="font-medium text-gray-900">{question.data.title}</li>
			</ol>
		</nav>

		<header class="mb-12">
			<div class="flex flex-wrap items-center gap-4 mb-6">
				<span class={`px-3 py-1 text-sm font-semibold rounded ${
					question.data.difficulty === 'Beginner' ? 'bg-green-100 text-green-800' :
					question.data.difficulty === 'Easy' ? 'bg-blue-100 text-blue-800' :
					question.data.difficulty === 'Medium' ? 'bg-yellow-100 text-yellow-800' :
					question.data.difficulty === 'Hard' ? 'bg-orange-100 text-orange-800' :
					'bg-red-100 text-red-800'
				}`}>
					{question.data.difficulty}
				</span>
				<span class="text-gray-500">Topic: <span class="font-medium text-gray-900">{topic?.data.title || 'Unknown'}</span></span>
				<span class="text-gray-500">Time: <span class="font-medium text-gray-900">{question.data.estimated_time} mins</span></span>
			</div>
			<h1 class="text-4xl font-extrabold text-gray-900 mb-4">{question.data.title}</h1>
			
			{relatedConcepts.length > 0 && (
				<div class="flex flex-wrap gap-2 mt-4">
					{relatedConcepts.map((concept) => concept && (
						<span class="px-3 py-1 bg-indigo-50 text-indigo-700 text-sm rounded-full border border-indigo-100">
							{concept.data.title}
						</span>
					))}
				</div>
			)}
		</header>

		<div class="prose prose-indigo prose-lg max-w-none border-b border-gray-100 pb-12 mb-12">
			<Content />
		</div>

		{renderedVariants.length > 0 && (
			<section class="mb-16">
				<h2 class="text-2xl font-bold text-gray-900 mb-6">Answers by Technology</h2>
				<div class="space-y-8">
					{renderedVariants.map((variant) => {
						const { VariantContent, tech } = variant;
						return (
							<div class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm">
								<div class="bg-gray-50 px-6 py-3 border-b border-gray-200 flex justify-between items-center">
									<h3 class="font-bold text-gray-900">{tech?.name || 'General'}</h3>
									{variant.data.difficulty_override && (
										<span class="text-xs font-medium text-gray-500 italic">Difficulty: {variant.data.difficulty_override}</span>
									)}
								</div>
								<div class="p-6 prose prose-indigo max-w-none">
									<VariantContent />
								</div>
							</div>
						);
					})}
				</div>
			</section>
		)}

		<footer class="mt-16 pt-8 border-t border-gray-200">
			<div class="flex flex-wrap items-center justify-between gap-4">
				<div>
					<h3 class="text-sm font-medium text-gray-500 uppercase tracking-wider">Companies</h3>
					<div class="mt-2 flex flex-wrap gap-2">
						{question.data.companies.map((companyId) => (
							<span class="text-gray-900 font-medium">{companyId}</span>
						))}
					</div>
				</div>
				<div class="text-sm text-gray-500">
					Last updated: {new Date(question.data.updated).toLocaleDateString()}
				</div>
			</div>
		</footer>
	</article>
</Layout>

<style is:global>
	@reference "../../styles/global.css";
	.prose h1 { @apply text-3xl font-bold mt-12 mb-6 pb-2 border-b border-gray-100; }
	.prose h2 { @apply text-2xl font-bold mt-10 mb-4; }
	.prose p { @apply my-4 leading-relaxed; }
	.prose ul { @apply list-disc list-inside my-4; }
	.prose li { @apply my-2; }
	.prose code { @apply px-1.5 py-0.5 bg-gray-100 rounded text-indigo-600 font-mono text-sm; }
	.prose pre { @apply p-4 bg-gray-900 text-gray-100 rounded-lg my-6 overflow-x-auto; }
	.prose pre code { @apply bg-transparent text-gray-100 p-0; }
	.prose hr { @apply my-12 border-gray-200; }
</style>
