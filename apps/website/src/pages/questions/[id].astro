---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { BookmarkButton } from '../../components/BookmarkButton';

export async function getStaticPaths() {
	const questions = await getCollection('questions');
	return questions.map((question) => ({
		params: { id: question.id },
		props: { question },
	}));
}

const { question } = Astro.props;
const { Content } = await render(question);

// Extract variations from raw body
const variationsMatch = question.body?.split('## Question Variations');
const variationsRaw = variationsMatch && variationsMatch.length > 1 ? variationsMatch[1] : '';
const variations = variationsRaw
	.split('\n')
	.map(line => line.trim())
	.filter(line => line.startsWith('- '))
	.map(line => line.replace('- ', ''));

const allTopics = await getCollection('topics');
const allConcepts = await getCollection('concepts');
const allVariants = await getCollection('variants');
const allTechnologies = await getCollection('technologies');

const topic = allTopics.find(t => t.data.id === question.data.topic);
const techMap = new Map(allTechnologies.map(t => [t.data.id, t.data]));

const questionVariants = allVariants
	.filter(v => v.data.question === question.data.id)
	.sort((a, b) => {
		const techA = techMap.get(a.data.technology);
		const techB = techMap.get(b.data.technology);
		const orderA = techA?.order ?? 999;
		const orderB = techB?.order ?? 999;
		return orderA - orderB;
	});

const relatedConcepts = question.data.concepts
	? question.data.concepts.map(id => allConcepts.find(c => c.data.id === id)).filter(Boolean)
	: [];

const renderedVariants = await Promise.all(questionVariants.map(async (variant) => {
	const { Content: VariantContent } = await render(variant);
	return {
		...variant,
		VariantContent,
		tech: techMap.get(variant.data.technology)
	};
}));

function getDifficultyClass(diff: string): string {
	return `badge--${diff.toLowerCase()}`;
}
---

<Layout title={question.data.title} description={`Interview question: ${question.data.title}. ${question.data.difficulty} difficulty, ${question.data.estimated_time} minutes.`}>
	<nav class="breadcrumbs" aria-label="Breadcrumb">
		<a href="/questions">Questions</a>
		<span class="breadcrumbs__separator">/</span>
		{topic && (
			<>
				<a href={`/topics/${topic.data.slug}`}>{topic.data.title}</a>
				<span class="breadcrumbs__separator">/</span>
			</>
		)}
		<span class="breadcrumbs__current">{question.data.title}</span>
	</nav>

	<article style="max-width: 1200px;">
		<header style="margin-bottom: 2rem;">
			<div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border-subtle);">
				<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem;">
					<span class={`badge ${getDifficultyClass(question.data.difficulty)}`}>{question.data.difficulty}</span>
					<span style="font-size: 0.8125rem; color: var(--color-text-tertiary); display: inline-flex; align-items: center; gap: 0.25rem;">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
						<span>{question.data.estimated_time} min</span>
					</span>
					{topic && (
						<a href={`/topics/${topic.data.slug}`} class="badge badge--topic">{topic.data.title}</a>
					)}
				</div>
				
				<div style="display: flex; align-items: center; gap: 1rem;">
					<BookmarkButton client:load questionId={question.id} />
					<div style="display: flex; align-items: baseline; gap: 0.375rem; white-space: nowrap;">
						<span style="font-size: 0.6875rem; color: var(--color-text-tertiary); text-transform: uppercase; font-weight: 700; letter-spacing: 0.02em;">Updated</span>
						<span style="font-size: 0.8125rem; color: var(--color-text-secondary);">{new Date(question.data.updated).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
					</div>
					<a href={`https://github.com/froghramar/QuestionForge/edit/main/content/questions/${question.id.replace('question.', '')}.md`}
					   target="_blank"
					   rel="noopener"
					   class="filter-btn"
					   style="font-size: 0.75rem; display: inline-flex; align-items: center; gap: 0.375rem; text-decoration: none; padding: 0.375rem 0.75rem;">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
						Edit
					</a>
				</div>
			</div>

			<h1 style="font-size: 2rem; font-weight: 800; letter-spacing: -0.03em; margin: 0 0 0.75rem; line-height: 1.2; color: var(--color-text-primary);">{question.data.title}</h1>

			{relatedConcepts.length > 0 && (
				<div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem;">
					<span style="font-size: 0.75rem; color: var(--color-text-tertiary); font-weight: 600; align-self: center; margin-right: 0.25rem;">CONCEPTS:</span>
					{relatedConcepts.map((concept) => concept && (
						<a href={`/concepts/${concept.data.id.replace('concept.', '')}`} class="badge badge--tech">{concept.data.title}</a>
					))}
				</div>
			)}
		</header>

		<div class="question-layout">
			<div class="question-main">
				<div class="prose question-content" style="padding-bottom: 2rem; margin-bottom: 2rem; border-bottom: 1px solid var(--color-border-default);">
					<Content />
				</div>

				{renderedVariants.length > 0 && (
					<section style="margin-bottom: 3rem;">
						<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
							<h2 style="font-size: 1.25rem; font-weight: 700; margin: 0;">Answers by Technology</h2>
							<a href="https://github.com/froghramar/QuestionForge/blob/main/CONTRIBUTING.md" target="_blank" rel="noopener" class="filter-btn" style="font-size: 0.75rem; text-decoration: none;">
								+ Add Variant
							</a>
						</div>

						{renderedVariants.length > 1 ? (
							<>
								<div class="tabs" id="variant-tabs">
									{renderedVariants.map((variant, i) => (
										<button
											class={`tab ${i === 0 ? 'tab--active' : ''}`}
											data-tab={`variant-${i}`}
											type="button"
										>
											{variant.tech?.name || 'General'}
											{variant.data.difficulty_override && (
												<span style="margin-left: 0.375rem; font-size: 0.6875rem; opacity: 0.6;">({variant.data.difficulty_override})</span>
											)}
										</button>
									))}
								</div>
								{renderedVariants.map((variant, i) => {
									const { VariantContent } = variant;
									return (
										<div class={`tab-panel ${i === 0 ? 'tab-panel--active' : ''}`} id={`variant-${i}`}>
											<div class="prose">
												<VariantContent />
											</div>
										</div>
									);
								})}
							</>
						) : (
							(() => {
								const SingleVariantContent = renderedVariants[0].VariantContent;
								return (
									<div style="border: 1px solid var(--color-border-default); border-radius: var(--radius-lg); overflow: hidden;">
										<div style="padding: 0.75rem 1rem; background: var(--color-surface-raised); border-bottom: 1px solid var(--color-border-default); font-family: var(--font-mono); font-size: 0.875rem; font-weight: 600; display: flex; justify-content: space-between; align-items: center;">
											<span>{renderedVariants[0].tech?.name || 'General'}</span>
											<a href={`https://github.com/froghramar/QuestionForge/edit/main/content/variants/${question.id.replace('question.', '')}/${renderedVariants[0].data.technology.replace('tech.', '')}.md`}
											   target="_blank" rel="noopener" style="font-size: 0.75rem; color: var(--color-text-secondary); text-decoration: none;">
												Improve this answer ✏️
											</a>
										</div>
										<div class="prose" style="padding: 1.25rem;">
											<SingleVariantContent />
										</div>
									</div>
								);
							})()
						)}
					</section>
				)}
			</div>

			<aside class="question-sidebar">
				{variations.length > 0 && (
					<div class="sidebar-card">
						<h3 class="sidebar-card__title">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.5rem;"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
							Question Variations
						</h3>
						<p class="sidebar-card__desc">Real-world ways this might be asked during an interview:</p>
						<ul class="sidebar-variations">
							{variations.map((v) => (
								<li>{v}</li>
							))}
						</ul>
					</div>
				)}

				<div class="sidebar-card" style="margin-top: 1.5rem; background: var(--color-accent-subtle); border-color: var(--color-accent-muted);">
					<h3 class="sidebar-card__title" style="color: var(--color-accent);">Pro Tip</h3>
					<p style="font-size: 0.8125rem; color: var(--color-text-secondary); margin: 0;">
						Interviewers rarely ask the exact question listed. Focus on understanding the core concepts and practice explaining these variations aloud.
					</p>
				</div>
			</aside>
		</div>
	</article>

	<style>
		.question-layout {
			display: grid;
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		@media (min-width: 1024px) {
			.question-layout {
				grid-template-columns: 1fr 320px;
			}
		}

		.question-main {
			min-width: 0;
		}

		.question-sidebar {
			display: flex;
			flex-direction: column;
		}

		.sidebar-card {
			background: var(--color-surface-raised);
			border: 1px solid var(--color-border-default);
			border-radius: var(--radius-lg);
			padding: 1.25rem;
		}

		.sidebar-card__title {
			display: flex;
			align-items: center;
			font-size: 0.875rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			margin: 0 0 0.75rem;
			color: var(--color-text-primary);
		}

		.sidebar-card__desc {
			font-size: 0.8125rem;
			color: var(--color-text-tertiary);
			margin: 0 0 1rem;
		}

		.sidebar-variations {
			margin: 0;
			padding: 0;
			list-style: none;
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
		}

		.sidebar-variations li {
			font-size: 0.875rem;
			line-height: 1.5;
			padding-left: 1.25rem;
			position: relative;
			color: var(--color-text-secondary);
		}

		.sidebar-variations li::before {
			content: "→";
			position: absolute;
			left: 0;
			color: var(--color-accent);
			font-weight: bold;
		}

		/* Hide the variations section in the main prose content */
		.question-content :global(h2:last-of-type),
		.question-content :global(h2:last-of-type ~ *) {
			display: none;
		}
	</style>

	<script>
		const tabsContainer = document.getElementById('variant-tabs');
		if (tabsContainer) {
			const tabs = tabsContainer.querySelectorAll<HTMLButtonElement>('.tab');
			tabs.forEach(tab => {
				tab.addEventListener('click', () => {
					// Deactivate all tabs and panels
					tabs.forEach(t => t.classList.remove('tab--active'));
					document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('tab-panel--active'));

					// Activate clicked tab and its panel
					tab.classList.add('tab--active');
					const panelId = tab.dataset.tab;
					if (panelId) {
						const panel = document.getElementById(panelId);
						if (panel) panel.classList.add('tab-panel--active');
					}
				});
			});
		}
	</script>
</Layout>
