---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allConcepts = await getCollection('concepts');
const allTopics = await getCollection('topics');

const conceptsByTopic = new Map();

allConcepts.forEach(concept => {
	const topicId = concept.data.topic;
	const list = conceptsByTopic.get(topicId) || [];
	list.push(concept);
	conceptsByTopic.set(topicId, list);
});

const sortedTopics = allTopics.filter(t => conceptsByTopic.has(t.data.id));
---

<Layout title="Concepts" description="Deep dives into technical interview concepts.">
	<div class="page-header" style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
		<div>
			<h1 class="page-header__title">Concepts</h1>
			<p class="page-header__subtitle">Foundational knowledge for software engineering interviews</p>
		</div>
		<a href="https://github.com/froghramar/QuestionForge/tree/main/content/concepts" target="_blank" rel="noopener" class="filter-btn filter-btn--active" style="text-decoration: none; font-size: 0.8125rem;">
			+ Propose Concept
		</a>
	</div>

	{sortedTopics.map(topic => {
		const concepts = conceptsByTopic.get(topic.data.id) || [];
		return (
			<div class="category-section">
				<h2 class="category-section__title">
					{topic.data.title}
				</h2>

				<div class="topic-grid stagger-children">
					{concepts.map((concept) => (
						<a href={`/concepts/${concept.data.slug}`} class="card card--interactive">
							<h3 class="card__title" style="font-size: 1.125rem; margin-bottom: 0.25rem;">{concept.data.title}</h3>
							{concept.data.description && (
								<p style="font-size: 0.8125rem; color: var(--color-text-secondary); margin: 0 0 0.75rem; line-height: 1.5;">{concept.data.description}</p>
							)}
						</a>
					))}
				</div>
			</div>
		);
	})}
</Layout>
