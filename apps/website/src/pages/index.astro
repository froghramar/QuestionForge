---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allQuestions = await getCollection('questions');
const allVariants = await getCollection('variants');
const allTopics = await getCollection('topics');
const allTechnologies = await getCollection('technologies');

const topicMap = new Map(allTopics.map(t => [t.data.id, t.data]));
const techMap = new Map(allTechnologies.map(t => [t.data.id, t.data]));

// Build a map of question ID -> tech names from variants
const questionTechMap = new Map<string, string[]>();
allVariants.forEach(v => {
	const techs = questionTechMap.get(v.data.question) || [];
	const tech = techMap.get(v.data.technology);
	if (tech) techs.push(tech.name);
	questionTechMap.set(v.data.question, techs);
});

// Get unique topics and difficulties for filters
const topics = [...new Set(allQuestions.map(q => q.data.topic))].map(id => topicMap.get(id)).filter(Boolean);
const difficulties = ['Beginner', 'Easy', 'Medium', 'Hard', 'Expert'];

// Sort questions: by difficulty order, then title
const diffOrder: Record<string, number> = { Beginner: 0, Easy: 1, Medium: 2, Hard: 3, Expert: 4 };
const sortedQuestions = [...allQuestions].sort((a, b) => (diffOrder[a.data.difficulty] || 0) - (diffOrder[b.data.difficulty] || 0));

function getDifficultyClass(diff: string): string {
	return `badge--${diff.toLowerCase()}`;
}
---

<Layout title="Questions" description="Open-source interview questions for developers. Browse by topic, difficulty, and technology.">
	<div class="page-header">
		<h1 class="page-header__title">Interview Questions</h1>
		<p class="page-header__subtitle">Open-source, community-reviewed questions for developers</p>
	</div>

	<div class="filter-bar" id="filter-bar">
		<button class="filter-btn filter-btn--active" data-filter="all">All</button>
		{difficulties.map(diff => (
			<button class={`filter-btn`} data-filter={`diff:${diff}`}>{diff}</button>
		))}
		{topics.map(topic => topic && (
			<button class="filter-btn" data-filter={`topic:${topic.id}`}>{topic.title}</button>
		))}
	</div>

	<div class="question-grid stagger-children" id="question-grid">
		{sortedQuestions.map((question) => {
			const topic = topicMap.get(question.data.topic);
			const techs = questionTechMap.get(question.data.id) || [];
			return (
				<a href={`/questions/${question.id}`}
				   class="card card--interactive"
				   data-difficulty={question.data.difficulty}
				   data-topic={question.data.topic}>
					<div class="card__header">
						<span class={`badge ${getDifficultyClass(question.data.difficulty)}`}>{question.data.difficulty}</span>
						<span class="question-card__time">
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
							{question.data.estimated_time}m
						</span>
					</div>
					<h2 class="card__title">{question.data.title}</h2>
					<div class="card__meta">
						{topic && <span class="badge badge--topic">{topic.title}</span>}
						<div class="question-card__techs">
							{techs.map(tech => (
								<span class="badge badge--tech">{tech}</span>
							))}
						</div>
					</div>
				</a>
			);
		})}
	</div>

	<script>
		const filterBar = document.getElementById('filter-bar');
		const grid = document.getElementById('question-grid');
		if (filterBar && grid) {
			const buttons = filterBar.querySelectorAll<HTMLButtonElement>('.filter-btn');
			const cards = grid.querySelectorAll<HTMLElement>('.card');

			buttons.forEach(btn => {
				btn.addEventListener('click', () => {
					buttons.forEach(b => b.classList.remove('filter-btn--active'));
					btn.classList.add('filter-btn--active');

					const filter = btn.dataset.filter || 'all';
					cards.forEach(card => {
						if (filter === 'all') {
							card.style.display = '';
							return;
						}
						const [type, value] = filter.split(':');
						const match = type === 'diff'
							? card.dataset.difficulty === value
							: card.dataset.topic === value;
						card.style.display = match ? '' : 'none';
					});
				});
			});
		}
	</script>
</Layout>
