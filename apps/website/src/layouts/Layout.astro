---
import '../styles/global.css';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Open-source interview questions for developers. Static-first, community-driven.' } = Astro.props;
const currentPath = Astro.url.pathname;

function isActive(path: string): boolean {
	if (path === '/') return currentPath === '/';
	return currentPath.startsWith(path);
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={`${title} · QuestionForge`} />
		<meta property="og:description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>{title} · QuestionForge</title>
		<script is:inline>
			(() => {
				const theme = localStorage.getItem('theme') || 'system';
				const root = document.documentElement;
				
				if (theme === 'system') {
					const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
					root.setAttribute('data-theme', systemTheme);
				} else {
					root.setAttribute('data-theme', theme);
				}
				
				root.setAttribute('data-theme-preference', theme);
			})();
		</script>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header__inner">
				<a href="/" class="site-logo">
					<svg class="site-logo__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
						<polyline points="14,2 14,8 20,8"/>
						<line x1="16" y1="13" x2="8" y2="13"/>
						<line x1="16" y1="17" x2="8" y2="17"/>
						<line x1="10" y1="9" x2="8" y2="9"/>
					</svg>
					QuestionForge
				</a>

				<div class="site-header__right">
					<nav class="site-nav" id="site-nav">
						<a href="/" class:list={['site-nav__link', { 'site-nav__link--active': isActive('/') }]}>Home</a>
						<a href="/questions" class:list={['site-nav__link', { 'site-nav__link--active': isActive('/questions') }]}>Questions</a>
						<a href="/topics" class:list={['site-nav__link', { 'site-nav__link--active': isActive('/topics') }]}>Topics</a>
						<a href="/paths" class:list={['site-nav__link', { 'site-nav__link--active': isActive('/paths') }]}>Paths</a>
						<a href="https://github.com/froghramar/QuestionForge" class="site-nav__link site-nav__link--github" target="_blank" rel="noopener">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
							GitHub
						</a>
					</nav>

					<div class="header-actions">
						<ThemeSwitcher />
						<button class="mobile-nav-toggle" id="mobile-nav-toggle" aria-label="Toggle navigation">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
								<line x1="3" y1="6" x2="21" y2="6"/>
								<line x1="3" y1="12" x2="21" y2="12"/>
								<line x1="3" y1="18" x2="21" y2="18"/>
							</svg>
						</button>
					</div>
				</div>
			</div>
		</header>

		<main class="site-main">
			<slot />
		</main>

		<footer class="site-footer">
			<span>Open Source</span>
			<span> · </span>
			<a href="https://github.com/froghramar/QuestionForge" target="_blank" rel="noopener">Contribute on GitHub</a>
		</footer>

		<script>
			const toggle = document.getElementById('mobile-nav-toggle');
			const nav = document.getElementById('site-nav');
			if (toggle && nav) {
				toggle.addEventListener('click', () => {
					nav.classList.toggle('site-nav--open');
				});
			}
		</script>
	</body>
</html>
