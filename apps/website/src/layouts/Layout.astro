---
import '../styles/global.css';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import GlobalSearch from '../components/GlobalSearch.astro';
import { Auth } from '../components/Auth';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Open-source interview questions for developers. Static-first, community-driven.' } = Astro.props;
const currentPath = Astro.url.pathname;

function isActive(path: string): boolean {
	if (path === '/') return currentPath === '/';
	return currentPath.startsWith(path);
}
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={`${title} · QuestionForge`} />
		<meta property="og:description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<title>{title} · QuestionForge</title>
		<script is:inline>
			(() => {
				const theme = localStorage.getItem('theme') || 'system';
				const root = document.documentElement;
				
				if (theme === 'system') {
					const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
					root.setAttribute('data-theme', systemTheme);
				} else {
					root.setAttribute('data-theme', theme);
				}
				
				root.setAttribute('data-theme-preference', theme);
			})();
		</script>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-50PFC8Y561" is:inline></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-50PFC8Y561');
		</script>
	</head>
	<body>
		<header class="site-header" data-pagefind-ignore>
			<div class="site-header__inner">
				<div class="site-header__left">
					<a href="/" class="site-logo">
						<svg class="site-logo__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
							<polyline points="14,2 14,8 20,8"/>
							<line x1="16" y1="13" x2="8" y2="13"/>
							<line x1="16" y1="17" x2="8" y2="17"/>
							<line x1="10" y1="9" x2="8" y2="9"/>
						</svg>
						<span class="site-logo__text">QuestionForge</span>
					</a>
				</div>

				<div class="site-header__center">
					<GlobalSearch />
				</div>

				<div class="site-header__right">
					<nav class="site-nav" id="site-nav">
						<a href="/questions" class:list={['site-nav__link', { 'site-nav__link--active': isActive('/questions') }]}>Questions</a>
						<a href="/topics" class:list={['site-nav__link', { 'site-nav__link--active': isActive('/topics') }]}>Topics</a>
						<a href="/paths" class:list={['site-nav__link', { 'site-nav__link--active': isActive('/paths') }]}>Paths</a>
					</nav>

					<div class="header-actions">
						<Auth client:load />
						<div class="header-actions__divider"></div>
						<ThemeSwitcher />
						<button class="mobile-nav-toggle" id="mobile-nav-toggle" aria-label="Toggle navigation">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
								<line x1="3" y1="6" x2="21" y2="6"/>
								<line x1="3" y1="12" x2="21" y2="12"/>
								<line x1="3" y1="18" x2="21" y2="18"/>
							</svg>
						</button>
					</div>
				</div>
			</div>
		</header>

		<main class="site-main" data-pagefind-body>
			<slot />
		</main>

		<footer class="site-footer" data-pagefind-ignore>
			<span>Open Source</span>
			<span> · </span>
			<a href="https://github.com/froghramar/QuestionForge" target="_blank" rel="noopener">Contribute on GitHub</a>
		</footer>

		<script>
			const toggle = document.getElementById('mobile-nav-toggle');
			const nav = document.getElementById('site-nav');
			if (toggle && nav) {
				toggle.addEventListener('click', () => {
					nav.classList.toggle('site-nav--open');
				});
			}
		</script>
	</body>
</html>
